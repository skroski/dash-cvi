# ---------------------------------------------------------------------------
# Lembretes (WhatsApp + IA). Copie este bloco para o .env da raiz do projeto
# (o .env já está no .gitignore) e preencha. NÃO use o prefixo VITE_: variável
# com VITE_ vai para o bundle do front e fica pública.
#
# Estas chaves são lidas pela edge function `lembretes` e NÃO pelo painel.
# São independentes das VITE_UAZAPI_* que o front (src/config/env.ts) já usa.
# Para publicá-las no Supabase:
#   node scripts/lembretes-segredos.mjs --enviar
# ---------------------------------------------------------------------------

# Chave da OpenAI (platform.openai.com > API keys). A IA escreve o texto.
OPENAI_API_KEY=

# uazapi: URL do servidor e token da instância de WhatsApp DESTA clínica.
# Ex.: https://suaconta.uazapi.com
UAZAPI_SERVER_URL=
UAZAPI_INSTANCE_TOKEN=

# Segredo que autoriza o agendador (pg_cron) a chamar a edge function.
# Pode deixar em branco: o script gera um valor aleatório e grava aqui.
LEMBRETES_CRON_SECRET=

# ---------------------------------------------------------------------------
# CENTRAL DE SEGREDOS (edge functions). Registro completo em
# supabase/functions/_shared/segredos.ts. Publique com:
#   node scripts/segredos.mjs --enviar
# A chave da OpenAI de produção fica no Vault (painel > card "Chave OpenAI");
# OPENAI_API_KEY aqui é apenas reserva.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
UAZAPI_WEBHOOK_SECRET=
ATENDIMENTO_INTERNAL_SECRET=
ATENDIMENTO_SEND_ENABLED=
AGENDA_CRON_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_FORMS_WEBHOOK_SECRET=
MAIA_OPENAI_MODEL=

# Só para scripts locais (não vai para o Supabase)
FISH_AUDIO_API_KEY=
